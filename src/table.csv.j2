{%- endmacro -%}
"ID","Level","UUID","Entity","Question type","Title","JSON key","JSON value","Value type","Extraction path","Findings"
{%- for row in table.rows %}
{{ cell(row.hi) }},{{ cell(row.level) }},{{ cell(row.uuid) }},{{ cell(row.type) }},{{ cell(row.kind) }},{{ cell(row.note) }},{{ cell(row.json_key) }},{{ cell(row.json_value) }},{{ cell(row.value_type) }},{{ cell(row.path) }},{{ cell(row.checks|map(attribute='message')|join(' | ')) }}
{%- endfor %}
{%- endautoescape %}
