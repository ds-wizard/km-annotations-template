{#- Helpers shared by the check table and the JSON schema.
    They follow `extract_replies` of Wizard 5.0 with {'version': '2'} (variant "simple"):
    annotations `json.key` (chapters, questions) and `json.value` (answers, choices). -#}
{#- Configuration of extract_replies that the template describes -#}
{%- set EXTRACTION = {'version': '2'} -%}
{%- set KEY = 'json.key' -%}
{%- set VALUE = 'json.value' -%}
{#- Fields the extraction adds to its objects, per kind of object -#}
{%- set META_FIELDS = {
  'answer': ['_uuid', '_label', '_value', '_path'],
  'item': ['_uuid', '_label', '_value', '_path'],
} -%}
{#- Methods of dicts: `x.items` in Jinja is the method, not the key -#}
{%- set DICT_METHODS = ['clear', 'copy', 'fromkeys', 'get', 'items', 'keys', 'pop', 'popitem', 'setdefault', 'update', 'values'] -%}
{#- =========================================================================== -#}
{#- Annotation of an entity as the extraction reads it (the first one of a key)
    out: value (none if missing), count (number of annotations with the key) -#}
{%- macro readAnnotation(entity, name, out) -%}
  {%- set v = entity.annotations.get(name) -%}
  {%- if v is none -%}
    {%- do out.update({'value': none, 'count': 0}) -%}
  {%- elif v is string -%}
    {%- do out.update({'value': v, 'count': 1}) -%}
  {%- else -%}
    {%- do out.update({'value': v[0], 'count': v|length}) -%}
  {%- endif -%}
{%- endmacro -%}
{#- Kind of a question as a short name -#}
{%- macro questionKind(question, out) -%}
  {%- if question is of_type('ValueQuestion') -%}
    {%- do out.update({'kind': 'value', 'detail': question.value_type|replace('QuestionValueType', '')|lower}) -%}
  {%- elif question is of_type('OptionsQuestion') -%}
    {%- do out.update({'kind': 'options', 'detail': ''}) -%}
  {%- elif question is of_type('MultiChoiceQuestion') -%}
    {%- do out.update({'kind': 'multi-choice', 'detail': ''}) -%}
  {%- elif question is of_type('ListQuestion') -%}
    {%- do out.update({'kind': 'list', 'detail': ''}) -%}
  {%- elif question is of_type('IntegrationQuestion') -%}
    {%- do out.update({'kind': 'integration', 'detail': ''}) -%}
  {%- elif question is of_type('ItemSelectQuestion') -%}
    {%- do out.update({'kind': 'item-select', 'detail': ''}) -%}
  {%- elif question is of_type('FileQuestion') -%}
    {%- do out.update({'kind': 'file', 'detail': ''}) -%}
  {%- else -%}
    {%- do out.update({'kind': 'unknown', 'detail': ''}) -%}
  {%- endif -%}
{%- endmacro -%}
{#- json.value as the extraction converts it (version 2: exactly true or false, and plain
    integers without leading zeros; everything else stays text)
    out: type (boolean, integer, string), value, note (why the result may surprise) -#}
{%- macro interpretValue(raw, out) -%}
  {%- set digits = raw[1:] if raw.startswith('-') else raw -%}
  {%- if raw in ['true', 'false'] -%}
    {%- do out.update({'type': 'boolean', 'value': raw == 'true', 'note': none}) -%}
  {%- elif digits and digits.isascii() and digits.isdigit() and (digits == '0' or not digits.startswith('0')) -%}
    {%- do out.update({'type': 'integer', 'value': raw|int, 'note': none}) -%}
  {%- else -%}
    {%- do out.update({'type': 'string', 'value': raw, 'note': none}) -%}
    {%- if raw.strip().lower() in ['true', 'false'] -%}
      {%- do out.update({'note': '"' ~ raw ~ '" stays text; only true and false (lowercase, without spaces) become booleans.'}) -%}
    {%- elif raw|float(none) is not none and raw.lower().strip('+-. ') not in ['nan', 'inf', 'infinity'] -%}
      {%- do out.update({'note': '"' ~ raw ~ '" stays text; only plain integers such as 12 or -3 (no leading zeros, decimals or spaces) become numbers.'}) -%}
    {%- endif -%}
  {%- endif -%}
{%- endmacro -%}
{#- Name and id of the knowledge model, also in the preview of a knowledge model editor
    out: name, id -#}
{%- macro source(dc, out) -%}
  {%- if dc.km_editor -%}
    {%- do out.update({'name': dc.km_editor.name, 'id': dc.km_editor.id ~ ':' ~ dc.km_editor.version ~ ' (editor)'}) -%}
  {%- elif dc.km_package -%}
    {%- do out.update({'name': dc.km_package.name, 'id': dc.km_package.id ~ ':' ~ dc.km_package.version}) -%}
  {%- else -%}
    {%- do out.update({'name': 'Knowledge model', 'id': ''}) -%}
  {%- endif -%}
{%- endmacro -%}
